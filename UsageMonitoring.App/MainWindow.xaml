<Window x:Class="UsageMonitoring.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:UsageMonitoring.App.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Usage Monitoring"
        Width="216"
        Height="190"
        MinWidth="216"
        MinHeight="190"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="{Binding AlwaysOnTop}"
        SourceInitialized="Window_SourceInitialized"
        Closing="Window_Closing"
        LocationChanged="Window_LocationChanged">

    <Window.Resources>
        <Style x:Key="QuotaLabelTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DDEFEFEF" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsQuotaLive}" Value="False">
                    <Setter Property="Foreground" Value="#88A1A5A5" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="QuotaPrimaryTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsQuotaLive}" Value="False">
                    <Setter Property="Foreground" Value="#B5C3C6C6" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="QuotaSecondaryTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F1F3F4" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsQuotaLive}" Value="False">
                    <Setter Property="Foreground" Value="#8EA0A4A6" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FiveHourRingStyle" TargetType="{x:Type controls:QuotaRing}">
            <Setter Property="RingBrush" Value="#12FFA6" />
            <Setter Property="TrackBrush" Value="#32755A" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsQuotaLive}" Value="False">
                    <Setter Property="RingBrush" Value="#5E9D86" />
                    <Setter Property="TrackBrush" Value="#26382F" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WeeklyRingStyle" TargetType="{x:Type controls:QuotaRing}">
            <Setter Property="RingBrush" Value="#5FE8FF" />
            <Setter Property="TrackBrush" Value="#2D6570" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsQuotaLive}" Value="False">
                    <Setter Property="RingBrush" Value="#6C949E" />
                    <Setter Property="TrackBrush" Value="#24373B" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="Transparent"
          ContextMenu="{StaticResource UnifiedAppContextMenu}"
          MouseLeftButtonDown="DragHandle_OnMouseLeftButtonDown">
        <Viewbox Stretch="Uniform">
            <Grid Width="334" Height="300">
                <Grid.RowDefinitions>
                    <RowDefinition Height="146" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="146" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Margin="20,16,20,16"
                        CornerRadius="42"
                        Background="#FF4A4A4A">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18"
                                          Direction="270"
                                          ShadowDepth="6"
                                          Opacity="0.16"
                                          Color="#000000" />
                    </Border.Effect>

                    <Grid Margin="18,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <controls:QuotaRing Width="78"
                                            Height="78"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Percentage="{Binding FiveHourCard.RemainingPercent}"
                                            Style="{StaticResource FiveHourRingStyle}"
                                            Thickness="6" />

                        <Grid Grid.Column="2">
                            <TextBlock Text="{Binding FiveHourCard.Label}"
                                       Margin="0,4,8,0"
                                       FontFamily="Segoe UI Semibold"
                                       FontSize="15"
                                       Style="{StaticResource QuotaLabelTextStyle}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Top"
                                       TextOptions.TextFormattingMode="Display" />
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding FiveHourCard.RemainingText}"
                                           FontFamily="Segoe UI Semibold"
                                           FontSize="40"
                                           Style="{StaticResource QuotaPrimaryTextStyle}"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center" />
                                <TextBlock Margin="2,-2,0,0"
                                           Text="{Binding FiveHourCard.ResetText}"
                                           FontFamily="Segoe UI Semibold"
                                           FontSize="18"
                                           Style="{StaticResource QuotaSecondaryTextStyle}"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        Margin="20,16,20,16"
                        CornerRadius="42"
                        Background="#FF4A4A4A">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18"
                                          Direction="270"
                                          ShadowDepth="6"
                                          Opacity="0.16"
                                          Color="#000000" />
                    </Border.Effect>

                    <Grid Margin="18,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <controls:QuotaRing Width="78"
                                            Height="78"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Percentage="{Binding WeeklyCard.RemainingPercent}"
                                            Style="{StaticResource WeeklyRingStyle}"
                                            Thickness="6" />

                        <Grid Grid.Column="2">
                            <TextBlock Text="{Binding WeeklyCard.Label}"
                                       Margin="0,4,8,0"
                                       FontFamily="Segoe UI Semibold"
                                       FontSize="15"
                                       Style="{StaticResource QuotaLabelTextStyle}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Top"
                                       TextOptions.TextFormattingMode="Display" />
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding WeeklyCard.RemainingText}"
                                           FontFamily="Segoe UI Semibold"
                                           FontSize="40"
                                           Style="{StaticResource QuotaPrimaryTextStyle}"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center" />
                                <TextBlock Margin="2,-2,0,0"
                                           Text="{Binding WeeklyCard.ResetText}"
                                           FontFamily="Segoe UI Semibold"
                                           FontSize="18"
                                           Style="{StaticResource QuotaSecondaryTextStyle}"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Viewbox>
    </Grid>
</Window>
