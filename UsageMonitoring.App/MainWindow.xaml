<Window x:Class="UsageMonitoring.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:UsageMonitoring.App.Controls"
        xmlns:models="clr-namespace:UsageMonitoring.App.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Usage Monitoring"
        Width="216"
        Height="{Binding PanelHeight}"
        MinWidth="216"
        MinHeight="95"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="{Binding EffectiveAlwaysOnTop}"
        SourceInitialized="Window_SourceInitialized"
        Closing="Window_Closing"
        LocationChanged="Window_LocationChanged"
        SizeChanged="Window_SizeChanged">

    <Window.Resources>
        <Style x:Key="QuotaLabelTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DDEFEFEF" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLive}" Value="False">
                    <Setter Property="Foreground" Value="#88A1A5A5" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="QuotaPrimaryTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLive}" Value="False">
                    <Setter Property="Foreground" Value="#B5C3C6C6" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="QuotaSecondaryTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F1F3F4" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLive}" Value="False">
                    <Setter Property="Foreground" Value="#8EA0A4A6" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DynamicQuotaRingStyle" TargetType="{x:Type controls:QuotaRing}">
            <Setter Property="RingBrush" Value="#12FFA6" />
            <Setter Property="TrackBrush" Value="#32755A" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Accent}" Value="{x:Static models:QuotaCardAccent.Cyan}">
                    <Setter Property="RingBrush" Value="#5FE8FF" />
                    <Setter Property="TrackBrush" Value="#2D6570" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Accent}" Value="{x:Static models:QuotaCardAccent.Amber}">
                    <Setter Property="RingBrush" Value="#FFD166" />
                    <Setter Property="TrackBrush" Value="#735E35" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Accent}" Value="{x:Static models:QuotaCardAccent.Muted}">
                    <Setter Property="RingBrush" Value="#6C949E" />
                    <Setter Property="TrackBrush" Value="#24373B" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLive}" Value="False">
                    <Setter Property="RingBrush" Value="#6C949E" />
                    <Setter Property="TrackBrush" Value="#24373B" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="Transparent"
          ContextMenu="{StaticResource UnifiedAppContextMenu}"
          MouseLeftButtonDown="DragHandle_OnMouseLeftButtonDown">
        <Viewbox Stretch="Uniform">
            <Grid Width="334" Height="{Binding PanelDesignHeight}">
                <ItemsControl ItemsSource="{Binding QuotaCards}"
                              HorizontalContentAlignment="Stretch">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Height" Value="146" />
                            <Setter Property="Margin" Value="0,0,0,8" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:RateLimitCardDisplay}">
                            <Border Margin="20,16"
                                    CornerRadius="42"
                                    Background="#FF4A4A4A"
                                    ToolTip="{Binding StatusText}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18"
                                                      Direction="270"
                                                      ShadowDepth="6"
                                                      Opacity="0.16"
                                                      Color="#000000" />
                                </Border.Effect>

                                <Grid Margin="18,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <controls:QuotaRing Width="78"
                                                        Height="78"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Percentage="{Binding RingPercentage}"
                                                        Style="{StaticResource DynamicQuotaRingStyle}"
                                                        Thickness="6" />

                                    <Grid Grid.Column="2">
                                        <TextBlock Text="{Binding Label}"
                                                   Margin="0,4,8,0"
                                                   FontFamily="Segoe UI Semibold"
                                                   FontSize="15"
                                                   Style="{StaticResource QuotaLabelTextStyle}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Top"
                                                   TextOptions.TextFormattingMode="Display" />
                                        <StackPanel HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <Viewbox MaxWidth="145"
                                                     MaxHeight="48"
                                                     Stretch="Uniform"
                                                     StretchDirection="DownOnly"
                                                     HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding RemainingText}"
                                                           FontFamily="Segoe UI Semibold"
                                                           FontSize="40"
                                                           Style="{StaticResource QuotaPrimaryTextStyle}"
                                                           TextAlignment="Center" />
                                            </Viewbox>
                                            <TextBlock Margin="2,-2,0,0"
                                                       Text="{Binding ResetText}"
                                                       FontFamily="Segoe UI Semibold"
                                                       FontSize="18"
                                                       Style="{StaticResource QuotaSecondaryTextStyle}"
                                                       TextAlignment="Center"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Viewbox>
    </Grid>
</Window>
